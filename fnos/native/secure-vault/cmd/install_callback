#!/bin/bash

# 安装回调：创建 venv 并安装依赖
# 策略：优先用包内预置的 wheels 离线安装（不依赖设备联网）；失败再回退在线清华源。

export PATH=/var/apps/python312/target/bin:$PATH

APP_DIR="${TRIM_APPDEST}/server"
PKGVAR="${TRIM_PKGVAR}"
VENV="${PKGVAR}/venv"
LOG="${PKGVAR}/install.log"
WHEELS="$APP_DIR/wheels"

mkdir -p "$PKGVAR"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG" 2>/dev/null || true
}

fail() {
    log_msg "FATAL: $1"
    echo "依赖安装失败：$1" > "$TRIM_TEMP_LOGFILE" 2>/dev/null || true
    exit 1
}

log_msg "=== install_callback start ==="
log_msg "APP_DIR=$APP_DIR"

[ -d "$APP_DIR" ] || fail "应用目录不存在"
command -v python3 >/dev/null 2>&1 || fail "python312 运行时未找到（检查 install_dep_apps）"

# 1. 创建 venv
if [ ! -x "$VENV/bin/python" ]; then
    log_msg "creating venv at $VENV"
    python3 -m venv "$VENV" >> "$LOG" 2>&1 || fail "创建 Python 虚拟环境失败"
fi
[ -x "$VENV/bin/python" ] || fail "venv 中无 python 可执行文件"

# 确保 venv 里有 pip（部分精简 python 的 venv 不带 pip）
if ! "$VENV/bin/python" -m pip --version >> "$LOG" 2>&1; then
    log_msg "venv 缺 pip，尝试 ensurepip"
    "$VENV/bin/python" -m ensurepip --upgrade >> "$LOG" 2>&1 || fail "venv 无 pip 且 ensurepip 失败"
fi

PIP="$VENV/bin/python -m pip"

# 2. 离线安装（包内 wheels）
if [ -d "$WHEELS" ] && [ -n "$(ls -A "$WHEELS" 2>/dev/null)" ]; then
    log_msg "离线安装（find-links=$WHEELS）"
    if $PIP install --no-index --find-links "$WHEELS" -r "$APP_DIR/requirements.txt" >> "$LOG" 2>&1; then
        log_msg "=== install_callback done (offline) ==="
        exit 0
    fi
    log_msg "离线安装失败，回退在线清华源"
fi

# 3. 在线回退
log_msg "在线安装（清华源）"
if $PIP install --no-cache-dir \
     -i https://pypi.tuna.tsinghua.edu.cn/simple \
     -r "$APP_DIR/requirements.txt" >> "$LOG" 2>&1; then
    log_msg "=== install_callback done (online) ==="
    exit 0
fi

fail "离线与在线安装均失败，详见 install.log"
