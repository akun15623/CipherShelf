#!/bin/bash

LOG_FILE="${TRIM_PKGVAR}/app.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"

# 飞牛 Python 运行时
export PATH=/var/apps/python312/target/bin:$PATH

APP_DIR="${TRIM_APPDEST}/server"
VENV="${TRIM_PKGVAR}/venv"
PORT="${TRIM_SERVICE_PORT}"

# 数据目录：用户在应用设置「授权目录」里点选的目录（取第一个，多个用 : 分隔）
DATA_DIR="${TRIM_DATA_ACCESSIBLE_PATHS%%:*}"

PY="$VENV/bin/python"

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"
}

check_process() {
    local pid="$1"
    kill -0 "$pid" 2>/dev/null
}

status_app() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
        if [ -n "$pid" ] && check_process "$pid"; then
            return 0
        fi
        rm -f "$PID_FILE"
    fi
    return 1
}

start_app() {
    if status_app; then
        return 0
    fi

    # 数据目录：用户在应用设置「授权目录」里点选的目录（取第一个，多个用 : 分隔）
    if [ -z "$DATA_DIR" ]; then
        # 未配置授权目录：用应用私有占位目录先启动，前端会引导用户去配置
        VAULT_ROOT="${TRIM_PKGVAR}/data"
        VAULT_UNCONFIGURED=1
        log_msg "未配置授权目录，使用占位目录启动，等待用户配置"
    else
        VAULT_ROOT="$DATA_DIR"
        VAULT_UNCONFIGURED=0
    fi

    if [ ! -x "$PY" ]; then
        log_msg "venv 不存在或 python 不可执行：$PY"
        echo "应用依赖未安装，请重新安装应用。" > "$TRIM_TEMP_LOGFILE"
        exit 1
    fi

    log_msg "Starting secure-vault (data=$VAULT_ROOT port=$PORT)..."
    cd "$APP_DIR" || exit 1

    VAULT_ROOT="$VAULT_ROOT" \
    VAULT_UNCONFIGURED="$VAULT_UNCONFIGURED" \
    PORT="$PORT" \
    VAULT_PASSWORD="$wizard_password" \
    nohup "$PY" -m uvicorn app:app --host 0.0.0.0 --port "$PORT" >> "$LOG_FILE" 2>&1 &

    echo "$!" > "$PID_FILE"
}

stop_app() {
    log_msg "Stopping secure-vault..."

    if [ ! -f "$PID_FILE" ]; then
        return 0
    fi

    local pid
    pid="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"

    if [ -z "$pid" ] || ! check_process "$pid"; then
        rm -f "$PID_FILE"
        return 0
    fi

    kill -TERM "$pid" 2>> "$LOG_FILE" || true

    local count=0
    while check_process "$pid" && [ "$count" -lt 10 ]; do
        sleep 1
        count=$((count + 1))
    done

    if check_process "$pid"; then
        kill -KILL "$pid" 2>> "$LOG_FILE" || true
    fi

    rm -f "$PID_FILE"
}

case "$1" in
start)
    start_app
    ;;
stop)
    stop_app
    ;;
status)
    if status_app; then
        exit 0
    fi
    exit 3
    ;;
*)
    echo "Unknown command: $1" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
